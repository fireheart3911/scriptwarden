{
  "name": "scriptwarden",
  "version": "0.1.0",
  "description": "Show caller & cue console for small theatre productions — script follow-along, multi-device live sync, and cue firing to Eos-family lighting consoles (OSC) and A&H desks (MIDI over TCP).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fireheart3911/scriptwarden.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun scripts/init-db.ts",
    "dev": "bun run scripts/dev.ts",
    "server": "bun --watch server/index.ts",
    "web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^8.1.3"
  }
}
